{
  "name": "software-engineer-kit",
  "version": "0.1.0",
  "description": "OpenCode V2 software engineering workflow plugin & master swe-agent with orchestrated stages, standalone skills, and shared domain/language overlays.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "swe-kit-setup": "./scripts/setup.ts"
  },
  "files": [
    "src",
    "skills",
    "agents",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "setup": "node scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/**/*.test.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
