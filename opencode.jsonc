{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./",
      "options": {
        "defaultPipeline": "feature",
        "confirmBefore": ["start", "implement"],
        "registerBundledSkills": true,
        "autoInjectContext": true,
        "trackFileEdits": true,
        "autoDetectProfiles": true
      }
    }
  ]
}
